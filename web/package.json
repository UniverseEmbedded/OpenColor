{
  "name": "opencolor-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "echo '⚠️ 已弃用：浏览器模式无法测试 Tauri API，请使用 pnpm test:e2e:tauri'",
    "test:e2e:ui": "echo '⚠️ 已弃用：浏览器模式无法测试 Tauri API，请使用 pnpm test:e2e:tauri'",
    "test:e2e:debug": "echo '⚠️ 已弃用：浏览器模式无法测试 Tauri API，请使用 pnpm test:e2e:tauri'",
    "test:e2e:tauri": "playwright test -c playwright.config.tauri.ts",
    "test:e2e:tauri:build": "pnpm tauri build && playwright test -c playwright.config.tauri.ts",
    "test:rust": "cd src-tauri && cargo test",
    "test:rust:verbose": "cd src-tauri && cargo test -- --nocapture",
    "test:all": "node scripts/test-with-timeout.js",
    "test:all:ps": "powershell -ExecutionPolicy Bypass -File scripts/test-with-timeout.ps1",
    "test:ci": "node scripts/test-with-timeout.js",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps",
    "playwright:codegen": "playwright codegen http://localhost:5173"
  },
  "dependencies": {
    "@tabler/icons-webfont": "^3.6.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "konva": "^9.3.16",
    "markdown-it": "^14.1.0",
    "three": "^0.162.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.7",
    "vue-konva": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^28.0.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
