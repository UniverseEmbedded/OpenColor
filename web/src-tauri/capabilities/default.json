{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "log:default",
    "log:allow-log",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOCUMENTS/OpenColor/**"
        },
        {
          "path": "$HOME/Documents/OpenColor/**"
        },
        {
          "path": "C:/Users/*/Documents/OpenColor/**"
        }
      ]
    }
  ]
}
